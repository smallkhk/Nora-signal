{
  "name": "signal-desktop",
  "version": "1.0.0",
  "description": "SIGNAL desktop app",
  "author": "SIGNAL",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "online.eclipselivecam.signal",
    "productName": "SIGNAL",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "smallkhk",
        "repo": "Nora-signal"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "vcam.js",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/out",
        "to": "vcam"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
